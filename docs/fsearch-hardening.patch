+
+struct Permit(Arc<AtomicUsize>);
+impl Permit {
+    fn acquire(active: Arc<AtomicUsize>) -> Option<Self> {
+        active.fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| (n < fsearch::security::MAX_CONNECTIONS).then_some(n + 1)).ok()?;
+        Some(Self(active))
+    }
+}
+impl Drop for Permit { fn drop(&mut self) { self.0.fetch_sub(1, Ordering::AcqRel); } }
+
+/// Each frame has a total deadline, including a peer sending one byte at a time.
+fn socket_frame(reader: &mut BufReader<UnixStream>) -> std::io::Result<Option<String>> {
+    struct Timed<'a> { reader: &'a mut BufReader<UnixStream>, deadline: Instant }
+    impl std::io::Read for Timed<'_> {
+        fn read(&mut self, _: &mut [u8]) -> std::io::Result<usize> { unreachable!("frame uses BufRead") }
+    }
+    impl BufRead for Timed<'_> {
+        fn fill_buf(&mut self) -> std::io::Result<&[u8]> {
+            let left = self.deadline.checked_duration_since(Instant::now()).ok_or_else(|| std::io::Error::new(std::io::ErrorKind::TimedOut, "frame deadline"))?;
+            self.reader.get_ref().set_read_timeout(Some(left))?;
+            self.reader.fill_buf()
+        }
+        fn consume(&mut self, n: usize) { self.reader.consume(n); }
+    }
+    fsearch::security::frame(&mut Timed { reader, deadline: Instant::now() + Duration::from_secs(1) })
+}
