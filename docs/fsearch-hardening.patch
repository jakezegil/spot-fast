+fn same_user(stream: &UnixStream) -> bool {
+    let (mut uid, mut gid) = (0, 0);
+    unsafe { libc::getpeereid(stream.as_raw_fd(), &mut uid, &mut gid) == 0 && uid == libc::geteuid() }
