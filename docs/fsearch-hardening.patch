+}
+
+fn launcher_query(v: &Value, home: &str) -> Result<Query, String> {
+    let obj = v.as_object().ok_or("request must be an object")?;
+    if obj.keys().any(|k| !["op", "q", "limit"].contains(&k.as_str())) { return Err("unsupported launcher field".into()); }
+    let text = v.get("q").and_then(Value::as_str).ok_or("q must be a string")?;
+    if text.len() > 1024 || text.contains('\0') || text.split_whitespace().count() > 16 { return Err("invalid query".into()); }
+    if ["grep:", "regex:", "sym:", "content:", "symbol:", "git:", "re:", "path:"].iter().any(|s| text.contains(s)) { return Err("filename-only endpoint".into()); }
+    let mut q = Query::parse(text, home)?;
+    if q.grep.is_some() || q.name_re.is_some() || q.path_re.is_some() { return Err("filename-only endpoint".into()); }
+    let limit = v.get("limit").map_or(Ok(30), |v| v.as_u64().ok_or("limit must be an unsigned integer"))?;
+    q.limit = limit.clamp(1, fsearch::security::MAX_RESULTS as u64) as usize;
+    Ok(q)
+}
+
+fn launcher_request(line: &str, engine: &Engine, home: &str) -> Result<Value, String> {
+    let v: Value = serde_json::from_str(line).map_err(|e| e.to_string())?;
+    match v.get("op").and_then(Value::as_str).unwrap_or("search") {
+        "ping" => Ok(json!({"ok": true, "profile": "spotfast-names-v1"})),
+        "status" => Ok(json!({"ok": true, "profile": "spotfast-names-v1", "status": engine.status()})),
+        "search" => {
+            if !engine.status().ready { return Err(engine.indexing()); }
+            let q = launcher_query(&v, home)?;
+            let hits = engine.search(&q)?;
+            Ok(json!({"ok": true, "profile": "spotfast-names-v1", "hits": hits.iter().map(|f| json!({"kind": kind_name(f.kind), "path": f.path.to_string_lossy(), "score": f.score})).collect::<Vec<_>>()}))
+        }
+        _ => Err("unsupported launcher operation".into()),
+    }
 }
 
